{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Workspace",
  "version": "0.1.0",
  "identifier": "app.aiworkspace.desktop",
  "build": {
    "beforeDevCommand": "npm start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/app/browser"
  },
  "app": {
    "windows": [{ "label": "main", "title": "AI Workspace", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://127.0.0.1:8765 http://localhost:8000 https:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool"
  }
}
