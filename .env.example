DATABASE_URL=postgresql+asyncpg://aiw:aiw@localhost:5432/aiw
REDIS_URL=redis://localhost:6379/0
# Générer: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# Clés AES-256 pour chiffrer les clés API des fournisseurs (séparées par des virgules ; la première chiffre).
# Vide = dérivée de JWT_SECRET (développement uniquement).
ENCRYPTION_KEY=
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=
CORS_ORIGINS=http://localhost:4200
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
SENTRY_DSN=
STORAGE_ENDPOINT_URL=
STORAGE_LOCAL_DIR=./.storage
FRONTEND_URL=http://localhost:4200
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ai-workspace.local
AUTH_RATE_PER_MIN=20
SANDBOX_ENABLED=false
DEFAULT_MODEL=anthropic/claude-sonnet-4
MAX_UPLOAD_MB=25
APP_ENV=development
# --- Outils (facultatifs) ---
SEARCH_URL=            # instance SearXNG pour l'outil web_search
GITHUB_TOKEN=          # jeton en lecture seule pour l'outil github
DEPLOY_HOOKS=          # JSON {"nom": "https://hook"} : seuls ces hooks nommés sont déployables
ALLOW_PRIVATE_PROVIDER_URLS=false   # true : autorise les fournisseurs sur réseau privé (Ollama distant…)
